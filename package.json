{
  "name": "handcrafted-fps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Operation Nightfall - a hand-built reference-quality browser FPS (WebGL / three.js).",
  "scripts": {
    "dev": "concurrently -n vite,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node tools/smoke.mjs",
    "server": "tsx watch server/index.ts",
    "dev:solo": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "puppeteer-core": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "three": "0.185.1"
  }
}
